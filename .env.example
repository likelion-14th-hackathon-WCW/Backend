# TODO: 아래 코드들을 각자 .env 파일에 복붙해주시면 됩니다!

# Django 프로젝트용
# your-secret-key-here 대신 실제 값으로 채워주세요.
SECRET_KEY=your-secret-key-here

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (docker-compose로 띄운 db 서비스 기준 - docker compose up -d db)
DB_NAME=wcw_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# OpenAI API용 - 노리개 조합/의미 추천, 상품 추천
# OPENAI_API_KEY= <- 이 줄은 반드시 필요.
# USE_MOCK_AI=True면 Mock 데이터로 동작해서 키 없이도 테스트 가능.
OPENAI_API_KEY=
USE_MOCK_AI=True