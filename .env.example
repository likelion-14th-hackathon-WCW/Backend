# Django 프로젝트용
# TODO: your-secret-key-here 대신 실제 키 값을 채워주시면 됩니다!
SECRET_KEY=your-secret-key-here
DEBUG=True

# OpenAI API용 - 노리개 조합/의미 추천, 상품 추천
# TODO: 여기에는 키 값이 없어도 되지만,
# TODO: OPENAI_API_KEY= <- 이 줄은 꼭 있어야 합니다!
# TODO: USE_MOCK_AI=True면 Mock 데이터로 동작해서 키 없이도 테스트 가능합니다!
OPENAI_API_KEY=

# True = Mock 데이터 사용 (API 키 없어도 동작), False = 실제 OpenAI 호출
USE_MOCK_AI=True